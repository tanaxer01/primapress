# ===========================================
# Prima Monorepo - Environment Variables
# ===========================================
# This repo uses two env files at the monorepo root:
#
#   .env.dev   — development store credentials (gitignored)
#   .env.prod  — production store credentials  (gitignored)
#
# Copy this file to both .env.dev and .env.prod and fill in the
# credentials for each respective Shopify store.
#
# The frontend (Next.js) still reads from .env.dev during local
# development. For production deploys, set these vars directly
# in your hosting platform (e.g., Vercel environment variables).

# ------------------------------------------
# Shopify Admin API (used by @prima/shopify-config scripts)
# Get these from: Dev Dashboard (dev.shopify.com) > Your App > Settings
# ------------------------------------------

# Your store handle (just the name, not the full domain)
SHOPIFY_SHOP=your-store

# Client ID and Client Secret from the Dev Dashboard app settings
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# API version (optional, defaults to 2026-01)
SHOPIFY_API_VERSION=2026-01

# ------------------------------------------
# Shopify Storefront API (used by @prima/frontend)
# ------------------------------------------

# Full store domain (e.g., https://your-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=https://your-store.myshopify.com

# Storefront access token (from Shopify Admin > Apps > Headless channel)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

